 # ── 2. --version ───────────────────────────────────────────────────────
-Say "concat.exe --version, with only Windows on the path"
-Expect-Ok "concat.exe --version" $exe @("--version") $bare 60
+Say "RBVideofire.exe --version, with only Windows on the path"
+Expect-Ok "RBVideofire.exe --version" $exe @("--version") $bare 60
 
